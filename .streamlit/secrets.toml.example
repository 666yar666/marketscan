# .streamlit/secrets.toml.example
# ВНИМАНИЕ: Это шаблон! Скопируйте это содержимое в панель "Secrets" на Streamlit Cloud / Hugging Face Spaces,
# и подставьте свои реальные значения. Никогда не коммитьте реальный файл secrets.toml в репозиторий!

[google_oauth]
client_id = "ТВОЙ_CLIENT_ID.apps.googleusercontent.com"
project_id = "marketscan-..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_secret = "ТВОЙ_CLIENT_SECRET"
redirect_uris = ["https://твой-апп.streamlit.app/"]
